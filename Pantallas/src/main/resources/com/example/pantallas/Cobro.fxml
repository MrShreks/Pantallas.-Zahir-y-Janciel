<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="700.0" prefWidth="700.0" spacing="30.0" styleClass="login-root" stylesheets="@Style5.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.pantallas.VentaController">
    <children>
        <VBox maxWidth="550.0" spacing="25.0" styleClass="card-premium">
            <children>
                <VBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label styleClass="title-medium" text="Procesar Pago" />
                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Label styleClass="label-muted" text="VENTA ID:" />
                                <Label fx:id="lblIdVenta" style="-fx-font-size: 18; -fx-font-weight: 800; -fx-text-fill: -accent;" text="#V-000001" />
                            </children>
                        </HBox>
                        <Separator maxWidth="300" opacity="0.2" />
                    </children>
                </VBox>

                <VBox alignment="CENTER" spacing="5.0" style="-fx-padding: 20 0;">
                    <children>
                        <Label styleClass="label-muted" text="MONTO TOTAL A COBRAR" />
                        <Label fx:id="lblMontoCobro" style="-fx-font-size: 42; -fx-font-weight: 900; -fx-text-fill: -success;" text="RD$ 0.00" />
                    </children>
                </VBox>

                <VBox spacing="15.0">
                    <children>
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="label-bold" text="MÉTODO DE PAGO" />
                                <ComboBox fx:id="comboMetodoPago" maxWidth="Infinity" prefHeight="50.0" promptText="Seleccionar..." />
                            </children>
                        </VBox>

                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="label-bold" text="EFECTIVO RECIBIDO" />
                                <TextField fx:id="txtEfectivoRecibido" prefHeight="55.0" promptText="0.00" style="-fx-font-size: 20; -fx-alignment: center;" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <VBox spacing="10.0">
                    <children>
                        <Button maxWidth="Infinity" onAction="#finalizarPago" prefHeight="60.0" styleClass="btn-primary" text="FINALIZAR FACTURA" />
                        <Button maxWidth="Infinity" onAction="#irAVentas" prefHeight="50.0" styleClass="btn-danger" style="-fx-background-color: transparent; -fx-text-fill: -danger;" text="CANCELAR Y VOLVER" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</VBox>
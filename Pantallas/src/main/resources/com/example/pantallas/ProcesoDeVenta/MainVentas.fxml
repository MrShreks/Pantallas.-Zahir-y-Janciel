<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox fx:id="rootPane" prefHeight="750.0" prefWidth="1300.0" stylesheets="@../Style5.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.pantallas.ProcesoDeVenta.VentaController">
    <fx:define>
        <ToggleGroup fx:id="tgUnidadMedida" />
    </fx:define>
    <children>
        <VBox prefWidth="280.0" styleClass="sidebar">
            <children>
                <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 40 20;">
                    <children>
                        <Label style="-fx-font-size: 50;" text="🧀" />
                        <Label style="-fx-font-size: 22; -fx-font-weight: 800; -fx-text-fill: white;" text="VENTAS" />
                        <Separator opacity="0.1" prefWidth="200.0" />
                    </children>
                </VBox>
                
                <VBox spacing="10" style="-fx-padding: 0 20;">
                    <Button fx:id="btnNavFacturacion" maxWidth="Infinity" onAction="#mostrarVentas" styleClass="nav-item-active" text="🛒 Panel de Ventas" />
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <VBox style="-fx-padding: 30;">
                    <Button maxWidth="Infinity" onAction="#volverAlMenu" prefHeight="50.0" styleClass="btn-danger" text="🏠 VOLVER AL MENÚ" />
                </VBox>
            </children>
        </VBox>

        <StackPane fx:id="contentArea" styleClass="main-content" HBox.hgrow="ALWAYS">
            <children>
                <!-- VISTA: VENTAS -->
                <VBox fx:id="viewVentas" spacing="25.0">
                    <children>
                        <Label styleClass="title-large" text="Registro de Facturación" />
                        
                        <VBox spacing="20.0" styleClass="card-premium">
                            <children>
                                <GridPane hgap="30.0" vgap="20.0">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="150" />
                                        <ColumnConstraints hgrow="ALWAYS" />
                                    </columnConstraints>
                                    <children>
                                        <Label styleClass="label-bold" text="CLIENTE" />
                                        <HBox spacing="15" GridPane.columnIndex="1">
                                            <ComboBox fx:id="cbCliente" maxWidth="Infinity" promptText="Seleccionar cliente..." HBox.hgrow="ALWAYS" />
                                            <Button onAction="#mostrarNuevoCliente" styleClass="btn-primary" text="+ NUEVO" />
                                        </HBox>
                                        
                                        <Label styleClass="label-bold" text="PRODUCTO" GridPane.rowIndex="1" />
                                        <ComboBox fx:id="cbProducto" onAction="#cargarPrecioSugerido" prefWidth="300.0" promptText="Seleccionar Queso..." GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                        
                                        <Label styleClass="label-bold" text="CANTIDAD" GridPane.rowIndex="2" />
                                        <HBox alignment="CENTER_LEFT" spacing="20" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                            <TextField fx:id="txtLibras" onKeyReleased="#calcularItem" prefWidth="150.0" promptText="Lbs" />
                                            <HBox spacing="15">
                                                <children>
                                                    <RadioButton fx:id="rbLibras" selected="true" text="Libras (Lbs)" toggleGroup="$tgUnidadMedida" />
                                                    <RadioButton fx:id="rbKilos" text="Kilos (Kg)" toggleGroup="$tgUnidadMedida" />
                                                </children>
                                            </HBox>
                                        </HBox>
                                        
                                        <Label styleClass="label-bold" text="PRECIO UNIT." GridPane.rowIndex="3" />
                                        <HBox alignment="CENTER_LEFT" spacing="20" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                            <TextField fx:id="txtPrecioUnitario" onKeyReleased="#calcularItem" prefWidth="150.0" promptText="RD$" style="-fx-text-fill: -success; -fx-font-weight: bold;" />
                                            <Label styleClass="label-muted" text="IMPORTE:" />
                                            <TextField fx:id="txtImporteTotal" editable="false" prefWidth="180.0" style="-fx-background-color: #f1f5f9; -fx-font-weight: 800;" text="0.00" />
                                        </HBox>
                                    </children>
                                </GridPane>
                                
                                <HBox alignment="CENTER_RIGHT" spacing="15">
                                    <Button fx:id="btnEditar" managed="false" onAction="#añadirItem" prefWidth="250" styleClass="btn-accent" text="ACTUALIZAR ITEM" visible="false" />
                                    <Button fx:id="btnAñadir" onAction="#añadirItem" prefWidth="250" styleClass="btn-primary" text="AÑADIR AL CARRITO" />
                                </HBox>
                            </children>
                        </VBox>
                        
                        <TableView fx:id="tablaVentas" VBox.vgrow="ALWAYS" />
                        
                        <HBox alignment="CENTER_RIGHT" spacing="30.0">
                            <VBox alignment="CENTER_RIGHT">
                                <Label styleClass="label-muted" text="TOTAL A PAGAR" />
                                <Label fx:id="lblTotal" style="-fx-font-size: 42; -fx-font-weight: 900; -fx-text-fill: -success;" text="RD$ 0.00" />
                            </VBox>
                            <Button onAction="#mostrarCobro" prefHeight="70.0" prefWidth="300.0" styleClass="btn-accent" style="-fx-font-size: 18;" text="PROCESAR PAGO" />
                        </HBox>
                    </children>
                </VBox>


                <!-- VISTA: COBRO (MODAL) -->
                <VBox fx:id="viewCobro" alignment="CENTER" managed="false" style="-fx-background-color: rgba(0,0,0,0.8);" visible="false">
                    <VBox alignment="CENTER" maxWidth="500" spacing="30" styleClass="card-premium">
                        <VBox alignment="CENTER" spacing="5">
                            <Label styleClass="title-medium" text="Finalizar Factura" />
                            <Label fx:id="lblMontoCobro" style="-fx-font-size: 32; -fx-font-weight: 900; -fx-text-fill: -success;" text="RD$ 0.00" />
                        </VBox>
                        
                        <VBox spacing="15">
                            <ComboBox fx:id="comboMetodoPago" maxWidth="Infinity" prefHeight="50" promptText="Método de Pago" />
                            <TextField fx:id="txtEfectivoRecibido" onKeyReleased="#calcularDevuelta" prefHeight="60" promptText="Monto Recibido RD$" style="-fx-font-size: 22; -fx-alignment: center; -fx-font-weight: bold;" />
                            <Label fx:id="lblDevuelta" style="-fx-font-size: 22; -fx-font-weight: 800; -fx-text-fill: -accent;" text="Devuelta: RD$ 0.00" />
                        </VBox>
                        
                        <VBox spacing="10">
                            <Button maxWidth="Infinity" onAction="#finalizarVenta" prefHeight="60" styleClass="btn-primary" text="CONFIRMAR Y CREAR ENVÍO" />
                            <Button maxWidth="Infinity" onAction="#mostrarVentas" styleClass="btn-danger" style="-fx-background-color: transparent; -fx-text-fill: -danger;" text="CANCELAR" />
                        </VBox>
                    </VBox>
                </VBox>

                <!-- VISTA: NUEVO CLIENTE (MODAL) -->
                <VBox fx:id="viewNuevoCliente" alignment="CENTER" managed="false" style="-fx-background-color: rgba(0,0,0,0.8);" visible="false">
                    <VBox alignment="CENTER" maxWidth="450" spacing="25" styleClass="card-premium">
                        <Label styleClass="title-medium" text="Registro de Cliente" />
                        
                        <VBox spacing="15">
                            <TextField fx:id="txtNewNombre" prefHeight="50" promptText="Nombre Completo" />
                            <TextField fx:id="txtNewRnc" prefHeight="50" promptText="RNC / Cédula" />
                            <TextField fx:id="txtNewTel" prefHeight="50" promptText="Teléfono de contacto" />
                        </VBox>
                        
                        <VBox spacing="10">
                            <Button maxWidth="Infinity" onAction="#guardarCliente" prefHeight="55" styleClass="btn-primary" text="REGISTRAR CLIENTE" />
                            <Button maxWidth="Infinity" onAction="#mostrarVentas" styleClass="btn-danger" style="-fx-background-color: transparent; -fx-text-fill: -danger;" text="DESCARTAR" />
                        </VBox>
                    </VBox>
                </VBox>
            </children>
        </StackPane>
    </children>
</HBox>
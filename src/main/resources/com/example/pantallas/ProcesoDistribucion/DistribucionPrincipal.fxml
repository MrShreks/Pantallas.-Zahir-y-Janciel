<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox prefHeight="750.0" prefWidth="1300.0" stylesheets="@../Style5.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.pantallas.controllers.DistribucionController">
    <children>
        <VBox prefWidth="280.0" styleClass="sidebar">
            <children>
                <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 40 20;">
                    <children>
                        <Label style="-fx-font-size: 50;" text="🛵" />
                        <Label style="-fx-font-size: 22; -fx-font-weight: 800; -fx-text-fill: white;" text="APP DELIVERY" />
                        <Separator opacity="0.1" prefWidth="200.0" />
                    </children>
                </VBox>
                
                <VBox spacing="10" style="-fx-padding: 0 20;">
                    <Button fx:id="btnNavPendientes" maxWidth="Infinity" onAction="#mostrarPendientes" styleClass="nav-item-active" text="1. Mis Envíos Pendientes" />
                    <Button fx:id="btnNavEntrega" maxWidth="Infinity" onAction="#mostrarEntrega" styleClass="nav-item" text="2. Confirmar Entrega" />
                    <Button fx:id="btnNavHistorial" maxWidth="Infinity" onAction="#mostrarHistorial" styleClass="nav-item" text="3. Historial de Entregas" />
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <VBox style="-fx-padding: 30;">
                    <Button maxWidth="Infinity" onAction="#irAMenuPrincipal" prefHeight="50.0" styleClass="btn-danger" text="🏠 VOLVER AL MENÚ" />
                </VBox>
            </children>
        </VBox>

        <StackPane fx:id="contentArea" styleClass="main-content" HBox.hgrow="ALWAYS">
            <children>
                <!-- PANEL: ENVIOS PENDIENTES -->
                <VBox fx:id="panePendientes" spacing="20.0">
                    <children>
                        <Label styleClass="title-large" text="Mis Envíos Asignados" />

                        <VBox spacing="15.0" styleClass="card-premium" VBox.vgrow="ALWAYS">
                            <children>
                                <Label styleClass="label-bold" text="Seleccione un envío pendiente para ver la ubicación e iniciar ruta:" />
                                <TableView fx:id="tablaPendientes" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colIdPendiente" prefWidth="70" text="ID" />
                                        <TableColumn fx:id="colClientePendiente" prefWidth="180" text="Cliente" />
                                        <TableColumn fx:id="colRepartidorPendiente" prefWidth="150" text="Repartidor" />
                                        <TableColumn fx:id="colDireccionPendiente" prefWidth="280" text="📍 Dirección de Entrega" />
                                        <TableColumn fx:id="colMontoPendiente" prefWidth="130" text="Monto" />
                                        <TableColumn fx:id="colEstatusPendiente" prefWidth="110" text="Estado" />
                                    </columns>
                                </TableView>

                                <!-- PANEL DE DETALLE DE UBICACIÓN (se muestra al seleccionar un envío) -->
                                <VBox fx:id="paneDetalleUbicacion" managed="false" spacing="12" style="-fx-background-color: #f0fdf4; -fx-border-color: #16a34a; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 16;" visible="false">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10">
                                            <Label style="-fx-font-size: 20;" text="📍" />
                                            <Label style="-fx-font-size: 15; -fx-font-weight: 800; -fx-text-fill: #15803d;" text="DESTINO DEL ENVÍO" />
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" spacing="30">
                                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                                <Label style="-fx-font-size: 11; -fx-text-fill: #64748b; -fx-font-weight: 700;" text="CLIENTE" />
                                                <Label fx:id="lblDetalleCliente" style="-fx-font-size: 14; -fx-font-weight: 700; -fx-text-fill: #1e293b;" text="-" />
                                            </VBox>
                                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                                <Label style="-fx-font-size: 11; -fx-text-fill: #64748b; -fx-font-weight: 700;" text="REPARTIDOR ASIGNADO" />
                                                <Label fx:id="lblDetalleRepartidor" style="-fx-font-size: 14; -fx-font-weight: 700; -fx-text-fill: #1e293b;" text="-" />
                                            </VBox>
                                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                                <Label style="-fx-font-size: 11; -fx-text-fill: #64748b; -fx-font-weight: 700;" text="MONTO A COBRAR" />
                                                <Label fx:id="lblDetalleMonto" style="-fx-font-size: 14; -fx-font-weight: 800; -fx-text-fill: #16a34a;" text="-" />
                                            </VBox>
                                        </HBox>
                                        <VBox spacing="4">
                                            <Label style="-fx-font-size: 11; -fx-text-fill: #64748b; -fx-font-weight: 700;" text="DIRECCIÓN COMPLETA DE ENTREGA" />
                                            <Label fx:id="lblDetalleDireccion" style="-fx-font-size: 15; -fx-font-weight: 700; -fx-text-fill: #0f172a; -fx-wrap-text: true;" text="-" wrapText="true" />
                                        </VBox>
                                        <HBox alignment="CENTER_LEFT" spacing="12">
                                            <Button fx:id="btnAbrirMapa" onAction="#abrirEnMapa" prefHeight="42" style="-fx-background-color: #1a73e8; -fx-text-fill: white; -fx-font-weight: 800; -fx-font-size: 13; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;" text="🗺  Ver en Google Maps" />
                                            <Button onAction="#iniciarRuta" prefHeight="42" prefWidth="220.0" styleClass="btn-primary" text="▶ INICIAR RUTA" />
                                        </HBox>
                                    </children>
                                </VBox>

                                <HBox alignment="CENTER_RIGHT" spacing="15">
                                    <Button onAction="#iniciarRuta" prefHeight="50.0" prefWidth="280.0" styleClass="btn-primary" text="▶ INICIAR RUTA DE ENVÍO" />
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- PANEL: CONFIRMAR ENTREGA -->
                <VBox fx:id="paneEntrega" managed="false" spacing="25.0" visible="false">
                    <children>
                        <Label styleClass="title-large" text="Cierre y Confirmación de Entrega" />
                        
                        <VBox maxWidth="700" spacing="25" styleClass="card-premium">
                            <children>
                                <VBox spacing="10">
                                    <Label styleClass="label-bold" text="Seleccione el Envío En Ruta" />
                                    <ComboBox fx:id="cbEnviosEnRuta" maxWidth="Infinity" prefHeight="50" promptText="Seleccionar envío..." />
                                </VBox>

                                <!-- Detalle de dirección en confirmación -->
                                <VBox fx:id="paneDetalleEntrega" managed="false" spacing="8" style="-fx-background-color: #eff6ff; -fx-border-color: #3b82f6; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14;" visible="false">
                                    <Label style="-fx-font-size: 12; -fx-text-fill: #64748b; -fx-font-weight: 700;" text="DIRECCIÓN DE ENTREGA" />
                                    <Label fx:id="lblEntregaDireccion" style="-fx-font-size: 14; -fx-font-weight: 700; -fx-text-fill: #1e3a8a; -fx-wrap-text: true;" text="-" wrapText="true" />
                                    <Button fx:id="btnMapaEntrega" onAction="#abrirMapaEntrega" prefHeight="36" style="-fx-background-color: #1a73e8; -fx-text-fill: white; -fx-font-weight: 700; -fx-font-size: 12; -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;" text="🗺  Ver en Google Maps" />
                                </VBox>
                                
                                <CheckBox fx:id="chkRecibido" style="-fx-font-size: 16; -fx-font-weight: bold;" text="Cliente firmó conformidad y se recibió el pago" />
                                
                                <VBox spacing="10">
                                    <Label styleClass="label-bold" text="Novedades o Incidencias" />
                                    <TextArea fx:id="txtNovedades" prefHeight="100.0" promptText="Reportar devoluciones, problemas de pago, etc..." />
                                </VBox>
                                
                                <Button maxWidth="Infinity" onAction="#finalizarEntregaYFacturar" prefHeight="60.0" styleClass="btn-primary" style="-fx-background-color: -success;" text="✓ CONFIRMAR ENTREGA Y EMITIR FACTURA" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- PANEL: HISTORIAL DE ENTREGAS -->
                <VBox fx:id="paneHistorial" managed="false" spacing="20.0" visible="false" style="-fx-padding: 30;">
                    <Label styleClass="title-large" text="Pedidos a Domicilio (Historial)" />
                    <VBox spacing="10" styleClass="card-premium" VBox.vgrow="ALWAYS">
                        <TableView fx:id="tablaHistorial" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colHistId" prefWidth="60" text="ID" />
                                <TableColumn fx:id="colHistCliente" prefWidth="200" text="Cliente" />
                                <TableColumn fx:id="colHistFecha" prefWidth="150" text="Fecha" />
                                <TableColumn fx:id="colHistTotal" prefWidth="130" text="Total" />
                                <TableColumn fx:id="colHistMetodo" prefWidth="150" text="Método de Pago" />
                                <TableColumn fx:id="colHistTipo" prefWidth="150" text="Tipo Entrega" />
                            </columns>
                        </TableView>
                        <Button onAction="#generarReporteDomicilio" maxWidth="Infinity" prefHeight="45" styleClass="btn-primary" text="📄 GENERAR REPORTE DE VENTAS A DOMICILIO" />
                    </VBox>
                </VBox>

            </children>
        </StackPane>
    </children>
</HBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox prefHeight="750.0" prefWidth="1300.0" stylesheets="@../Style5.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.pantallas.ProcesoDeCompras.CompraController">
    <children>
        <VBox prefWidth="280.0" styleClass="sidebar">
            <children>
                <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 40 20;">
                    <children>
                        <Label style="-fx-font-size: 50;" text="🧀" />
                        <Label style="-fx-font-size: 22; -fx-font-weight: 800; -fx-text-fill: white;" text="COMPRAS" />
                        <Separator opacity="0.1" prefWidth="200.0" />
                    </children>
                </VBox>
                
                <VBox spacing="10" style="-fx-padding: 0 20;">
                    <Button fx:id="btnNavOrden" maxWidth="Infinity" onAction="#mostrarNuevaOrden" styleClass="nav-item-active" text="🛒 Generar Orden" />
                    <Button fx:id="btnNavRecepcion" maxWidth="Infinity" onAction="#mostrarRecepcion" styleClass="nav-item" text="📦 Recepción de Insumos" />
                    <Button fx:id="btnNavHistorial" maxWidth="Infinity" onAction="#mostrarHistorial" styleClass="nav-item" text="📋 Historial y Estados" />
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <VBox style="-fx-padding: 30;">
                    <Button maxWidth="Infinity" onAction="#irAMenuPrincipal" prefHeight="50.0" styleClass="btn-danger" text="🏠 VOLVER AL MENÚ" />
                </VBox>
            </children>
        </VBox>

        <StackPane styleClass="main-content" HBox.hgrow="ALWAYS">
            <children>
                <!-- PANEL: NUEVA ORDEN -->
                <VBox fx:id="paneNuevaOrden" spacing="25.0">
                    <children>
                        <Label styleClass="title-large" text="Nueva Orden de Compra" />

                        <VBox spacing="20.0" styleClass="card-premium">
                            <children>
                                <GridPane hgap="30" vgap="20">
                                    <columnConstraints>
                                        <ColumnConstraints prefWidth="150" />
                                        <ColumnConstraints hgrow="ALWAYS" />
                                        <ColumnConstraints prefWidth="150" />
                                        <ColumnConstraints hgrow="ALWAYS" />
                                    </columnConstraints>
                                    <children>
                                        <Label styleClass="label-bold" text="Suplidor:" />
                                        <ComboBox fx:id="cbSuplidor" maxWidth="Infinity" GridPane.columnIndex="1" />

                                        <Label styleClass="label-bold" text="Insumo:" GridPane.rowIndex="1" />
                                        <ComboBox fx:id="cbInsumo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                        <Label styleClass="label-bold" text="Cantidad:" GridPane.columnIndex="2" />
                                        <HBox spacing="10" GridPane.columnIndex="3">
                                            <children>
                                                <TextField fx:id="txtCantidad" HBox.hgrow="ALWAYS" />
                                                <ComboBox fx:id="cbUnidad" prefWidth="100.0" />
                                            </children>
                                        </HBox>

                                        <Label styleClass="label-bold" text="Precio Est. (RD$):" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                        <Label fx:id="lblPrecioUnitario" style="-fx-font-size: 18; -fx-font-weight: 800; -fx-text-fill: -success;" text="RD$ 0.00" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                                        <Label styleClass="label-bold" text="Fecha Entrega:" GridPane.rowIndex="2" />
                                        <DatePicker fx:id="dpFechaEntrega" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    </children>
                                </GridPane>
                                
                                <HBox alignment="CENTER_RIGHT" spacing="15">
                                    <Button onAction="#limpiarDatosOrden" prefWidth="150.0" styleClass="btn-danger" style="-fx-background-color: transparent; -fx-text-fill: -danger;" text="LIMPIAR" />
                                    <Button onAction="#generarOrden" prefWidth="250.0" styleClass="btn-primary" text="GUARDAR ORDEN" />
                                </HBox>
                            </children>
                        </VBox>
                        
                        <Label styleClass="title-medium" text="Órdenes Recientes" />
                        <TableView fx:id="tablaOrdenesPendientes" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>

                <!-- PANEL: RECEPCIÓN -->
                <VBox fx:id="paneRecepcion" managed="false" spacing="25.0" visible="false">
                    <children>
                        <Label styleClass="title-large" text="Recepción de Insumos" />
                        
                        <VBox spacing="20" styleClass="card-premium">
                            <children>
                                <VBox spacing="10">
                                    <Label styleClass="label-bold" text="Seleccionar Orden Pendiente" />
                                    <ComboBox fx:id="cbOrdenesPendientes" maxWidth="Infinity" promptText="ID - Suplidor (Insumo)" />
                                </VBox>
                                
                                <VBox spacing="10">
                                    <Label styleClass="label-bold" text="Cantidad Real Recibida" />
                                    <TextField fx:id="txtCantidadRecibida" maxWidth="250" prefHeight="50" style="-fx-font-size: 18;" />
                                </VBox>

                                <VBox spacing="10">
                                    <Label styleClass="label-bold" text="Notas de Recepción" />
                                    <TextArea fx:id="txtNotasRecepcion" prefHeight="100" promptText="Estado de los productos, lote, etc..." />
                                </VBox>
                                
                                <HBox alignment="CENTER_RIGHT">
                                    <Button onAction="#confirmarRecepcion" prefWidth="300.0" styleClass="btn-primary" text="REGISTRAR ENTRADA" />
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- PANEL: HISTORIAL -->
                <VBox fx:id="paneHistorial" managed="false" spacing="25.0" visible="false">
                    <children>
                        <Label styleClass="title-large" text="Historial de Compras" />
                        
                        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="card">
                            <children>
                                <Label styleClass="label-bold" text="Acciones en lote:" />
                                <ComboBox fx:id="cbNuevoEstado" prefHeight="40" prefWidth="200" promptText="Cambiar estado..." />
                                <Button onAction="#actualizarEstadoMasivo" prefHeight="40" styleClass="btn-accent" text="ACTUALIZAR" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button onAction="#borrarRegistroHistorial" prefHeight="40" styleClass="btn-danger" text="ELIMINAR" />
                            </children>
                        </HBox>
                        <TableView fx:id="tablaHistorial" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</HBox>

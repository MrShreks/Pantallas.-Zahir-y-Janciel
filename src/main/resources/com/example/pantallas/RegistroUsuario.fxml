<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="500" prefWidth="450" spacing="20" style="-fx-background-color: #f8fafc; -fx-padding: 40;" stylesheets="@Style5.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.pantallas.controllers.RegistroUsuarioController">
    <children>
        <Label style="-fx-font-size: 24; -fx-font-weight: 800; -fx-text-fill: #0f172a;" text="Registro de Usuario" />
        <Separator prefWidth="300" />

        <VBox spacing="15" maxWidth="350">
            <children>
                <VBox spacing="5">
                    <Label text="Nombre Completo:" style="-fx-font-weight: bold;" />
                    <TextField fx:id="txtNombreCompleto" prefHeight="40" promptText="Ej: Emil Gomez Gomez" />
                </VBox>
                <VBox spacing="5">
                    <Label text="Usuario:" style="-fx-font-weight: bold;" />
                    <TextField fx:id="txtUsuario" prefHeight="40" promptText="Nombre de inicio de sesión" />
                </VBox>
                <VBox spacing="5">
                    <Label text="Contraseña:" style="-fx-font-weight: bold;" />
                    <PasswordField fx:id="txtClave" prefHeight="40" promptText="••••••••" />
                </VBox>
                <VBox spacing="5">
                    <Label text="Rol asignado:" style="-fx-font-weight: bold;" />
                    <Label style="-fx-font-size: 14; -fx-text-fill: #3498db; -fx-font-weight: bold;" text="💰 VENTAS (Comprador)" />
                </VBox>
            </children>
        </VBox>

        <Label fx:id="lblError" style="-fx-text-fill: #e74c3c; -fx-font-size: 12; -fx-font-weight: bold;" text="" wrapText="true" />

        <HBox alignment="CENTER" spacing="15">
            <children>
                <Button fx:id="btnCancelar" onAction="#cancelar" prefHeight="40" prefWidth="120" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold;" text="CANCELAR" />
                <Button onAction="#guardar" prefHeight="40" prefWidth="150" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" text="💾 GUARDAR" />
            </children>
        </HBox>

        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11;" text="Todos los campos son obligatorios" />
    </children>
</VBox>

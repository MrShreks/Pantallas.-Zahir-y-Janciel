<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox prefHeight="750.0" prefWidth="1300.0" stylesheets="@../Style5.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.pantallas.controllers.MantenimientoController">
    <children>
        <VBox prefWidth="280.0" styleClass="sidebar">
            <children>
                <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 40 20;">
                    <children>
                        <Label style="-fx-font-size: 50;" text="🛠️" />
                        <Label style="-fx-font-size: 22; -fx-font-weight: 800; -fx-text-fill: white;" text="MANTENIMIENTO" />
                        <Separator opacity="0.1" prefWidth="200.0" />
                    </children>
                </VBox>
                
                <VBox spacing="10" style="-fx-padding: 0 20;">
                    <Button fx:id="btnNavEquipos" maxWidth="Infinity" onAction="#irAEquipos" styleClass="nav-item-active" text="1. Gestión de Equipos" />
                    <Button fx:id="btnNavPlanificacion" maxWidth="Infinity" onAction="#irAPlanificacion" styleClass="nav-item" text="2. Programar Tarea" />
                    <Button fx:id="btnNavHistorial" maxWidth="Infinity" onAction="#irAHistorial" styleClass="nav-item" text="3. Historial / Tareas" />
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <VBox style="-fx-padding: 30;">
                    <Button maxWidth="Infinity" onAction="#volverMenu" prefHeight="50.0" styleClass="btn-danger" text="🏠 VOLVER AL MENÚ" />
                </VBox>
            </children>
        </VBox>

        <StackPane styleClass="main-content" HBox.hgrow="ALWAYS">
            <children>
                <!-- PANEL: EQUIPOS -->
                <VBox fx:id="paneEquipos" spacing="25.0">
                    <children>
                        <Label styleClass="title-large" text="Inventario de Maquinaria" />

                        <VBox spacing="20.0" styleClass="card-premium">
                            <children>
                                <GridPane hgap="30" vgap="20">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="150" />
                                        <ColumnConstraints hgrow="ALWAYS" />
                                    </columnConstraints>
                                    <children>
                                        <Label styleClass="label-bold" text="Nombre Equipo" />
                                        <TextField fx:id="txtNombreEquipo" maxWidth=" Infinity" promptText="Ej: Pasteurizadora Industrial" GridPane.columnIndex="1" />

                                        <Label styleClass="label-bold" text="Modelo / Serie" GridPane.rowIndex="1" />
                                        <TextField fx:id="txtModelo" maxWidth="Infinity" promptText="Ej: PV-2024-X1" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                        <Label styleClass="label-bold" text="Estado Actual" GridPane.rowIndex="2" />
                                        <ComboBox fx:id="cbEstadoEquipo" maxWidth="Infinity" promptText="Seleccionar condición..." GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    </children>
                                </GridPane>
                                
                                <HBox alignment="CENTER_RIGHT" spacing="15">
                                    <Button onAction="#limpiarCampos" prefWidth="120.0" styleClass="btn-danger" style="-fx-background-color: transparent; -fx-text-fill: -danger;" text="LIMPIAR" />
                                    <Button onAction="#borrarEquipo" prefWidth="120.0" styleClass="btn-danger" text="BORRAR" />
                                    <Button onAction="#actualizarEquipo" prefWidth="150.0" styleClass="btn-accent" text="ACTUALIZAR" />
                                    <Button onAction="#guardarEquipo" prefWidth="180.0" styleClass="btn-primary" text="GUARDAR EQUIPO" />
                                </HBox>
                            </children>
                        </VBox>
                        
                        <TableView fx:id="tablaMaquinaria" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="80" text="ID" />
                                <TableColumn fx:id="colNombre" prefWidth="300" text="Nombre Maquinaria" />
                                <TableColumn fx:id="colModelo" prefWidth="200" text="Modelo/Serie" />
                                <TableColumn fx:id="colEstado" prefWidth="150" text="Estado" />
                                <TableColumn fx:id="colUltimoManto" prefWidth="180" text="Último Manto." />
                            </columns>
                        </TableView>
                    </children>
                </VBox>

                <!-- PANEL: PLANIFICACIÓN -->
                <VBox fx:id="panePlanificacion" managed="false" spacing="25.0" visible="false">
                    <children>
                        <Label styleClass="title-large" text="Programar Mantenimiento" />
                        
                        <VBox maxWidth="600" spacing="20" styleClass="card-premium">
                            <children>
                                <VBox spacing="10">
                                    <Label styleClass="label-bold" text="Seleccione el Equipo" />
                                    <ComboBox fx:id="cbEquipos" maxWidth="Infinity" prefHeight="45" />
                                </VBox>
                                
                                <HBox spacing="30">
                                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                                        <Label styleClass="label-bold" text="Fecha Programada" />
                                        <DatePicker fx:id="dpFechaManto" maxWidth="Infinity" prefHeight="45" />
                                    </VBox>
                                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                                        <Label styleClass="label-bold" text="Tipo de Intervención" />
                                        <HBox spacing="20" style="-fx-padding: 10 0;">
                                            <RadioButton fx:id="rbPreventivo" selected="true" text="Preventivo" />
                                            <RadioButton fx:id="rbCorrectivo" text="Correctivo" />
                                        </HBox>
                                    </VBox>
                                </HBox>
                                
                                <Button maxWidth="Infinity" onAction="#programarTarea" prefHeight="55" styleClass="btn-primary" text="AGENDAR TAREA AHORA" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- PANEL: HISTORIAL -->
                <VBox fx:id="paneHistorial" managed="false" spacing="25.0" visible="false">
                    <children>
                        <Label styleClass="title-large" text="Historial de Intervenciones" />
                        <TableView fx:id="tablaHistorial" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colHistFecha" prefWidth="180" text="Fecha Programada" />
                                <TableColumn fx:id="colHistEquipo" prefWidth="300" text="Equipo Intervenido" />
                                <TableColumn fx:id="colHistTipo" prefWidth="150" text="Tipo" />
                                <TableColumn fx:id="colHistEstado" prefWidth="150" text="Estado Actual" />
                                <TableColumn fx:id="colHistAccion" prefWidth="200" text="Acciones" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</HBox>

<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="Factura" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" language="java">

    <parameter name="numeroFactura" class="java.lang.String"/>
    <parameter name="cliente" class="java.lang.String"/>
    <parameter name="fecha" class="java.util.Date"/>
    <parameter name="subtotal" class="java.lang.Double"/>
    <parameter name="itbis" class="java.lang.Double"/>
    <parameter name="total" class="java.lang.Double"/>
    <parameter name="metodoPago" class="java.lang.String"/>
    <parameter name="tipoEntrega" class="java.lang.String"/>

    <field name="descripcion" class="java.lang.String"/>
    <field name="libras" class="java.lang.Double"/>
    <field name="precioUnitario" class="java.lang.Double"/>
    <field name="subtotal" class="java.lang.Double"/>

    <background>
        <band height="802">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="802"/>
                <graphicElement>
                    <pen lineWidth="2.0" lineColor="#b8860b"/>
                </graphicElement>
            </rectangle>
            <rectangle>
                <reportElement x="3" y="3" width="549" height="796"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#e0d5c0"/>
                </graphicElement>
            </rectangle>
        </band>
    </background>

    <title>
        <band height="210">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="80" mode="Opaque" backcolor="#0f3d24"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement x="0" y="12" width="555" height="35" mode="Opaque" backcolor="#0f3d24" forecolor="#daa520"/>
                <textElement textAlignment="Center">
                    <font fontName="Segoe UI" size="24" isBold="true"/>
                </textElement>
                <text><![CDATA[QUESERÍA SANTIAGUERO]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="48" width="555" height="18" mode="Opaque" backcolor="#0f3d24" forecolor="#c9a96e"/>
                <textElement textAlignment="Center">
                    <font fontName="Segoe UI" size="10" isItalic="true"/>
                </textElement>
                <text><![CDATA[Calidad y tradicion desde 1990]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="88" width="555" height="18" forecolor="#555555"/>
                <textElement textAlignment="Center">
                    <font fontName="Segoe UI" size="8"/>
                </textElement>
                <text><![CDATA[Calle Principal No. 123, Santiago, Republica Dominicana | Tel: 809-555-0000]]></text>
            </staticText>

            <line>
                <reportElement x="20" y="108" width="515" height="2"/>
                <graphicElement>
                    <pen lineWidth="1.5" lineColor="#b8860b"/>
                </graphicElement>
            </line>

            <staticText>
                <reportElement x="20" y="115" width="200" height="25" forecolor="#0f3d24"/>
                <textElement>
                    <font fontName="Segoe UI" size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[FACTURA]]></text>
            </staticText>

            <textField>
                <reportElement x="325" y="115" width="210" height="18" forecolor="#555555"/>
                <textElement textAlignment="Right">
                    <font fontName="Segoe UI" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["No. " + $P{numeroFactura}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="325" y="133" width="210" height="18" forecolor="#555555"/>
                <textElement textAlignment="Right">
                    <font fontName="Segoe UI" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Fecha: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{fecha})]]></textFieldExpression>
            </textField>

            <rectangle>
                <reportElement x="20" y="155" width="515" height="45" mode="Opaque" backcolor="#faf8f5"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#d4c5a9"/>
                </graphicElement>
            </rectangle>

            <textField>
                <reportElement x="25" y="174" width="505" height="20" forecolor="#1e293b"/>
                <textElement>
                    <font fontName="Segoe UI" size="13" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{cliente}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="30">
            <rectangle>
                <reportElement x="20" y="0" width="515" height="30" mode="Opaque" backcolor="#b8860b"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="25" y="5" width="215" height="22" forecolor="#ffffff"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Segoe UI" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[PRODUCTO]]></text>
            </staticText>
            <staticText>
                <reportElement x="240" y="5" width="80" height="22" forecolor="#ffffff"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Segoe UI" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[CANTIDAD]]></text>
            </staticText>
            <staticText>
                <reportElement x="320" y="5" width="110" height="22" forecolor="#ffffff"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Segoe UI" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[PRECIO UNIT.]]></text>
            </staticText>
            <staticText>
                <reportElement x="430" y="5" width="100" height="22" forecolor="#ffffff"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Segoe UI" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[SUBTOTAL]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="24">
            <rectangle>
                <reportElement x="20" y="0" width="515" height="24" mode="Opaque" backcolor="#faf8f5">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT}.intValue() % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <line>
                <reportElement x="20" y="23" width="515" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.3" lineColor="#e8e0d0"/>
                </graphicElement>
            </line>
            <textField>
                <reportElement x="25" y="2" width="215" height="20" forecolor="#333333"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Segoe UI" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="240" y="2" width="80" height="20" forecolor="#333333"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Segoe UI" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[new java.text.DecimalFormat("#,##0.00").format($F{libras})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="320" y="2" width="110" height="20" forecolor="#333333"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Segoe UI" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["RD$ " + new java.text.DecimalFormat("#,##0.00").format($F{precioUnitario})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="430" y="2" width="100" height="20" forecolor="#333333"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Segoe UI" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["RD$ " + new java.text.DecimalFormat("#,##0.00").format($F{subtotal})]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="195">
            <line>
                <reportElement x="280" y="0" width="255" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.5" lineColor="#b8860b"/>
                </graphicElement>
            </line>

            <textField>
                <reportElement x="280" y="6" width="255" height="20" forecolor="#555555"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Segoe UI" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Subtotal:                 RD$ " + new java.text.DecimalFormat("#,##0.00").format($P{subtotal})]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="280" y="26" width="255" height="20" forecolor="#555555"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Segoe UI" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["ITBIS (18%):              RD$ " + new java.text.DecimalFormat("#,##0.00").format($P{itbis})]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="280" y="49" width="255" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#b8860b"/>
                </graphicElement>
            </line>

            <rectangle>
                <reportElement x="280" y="53" width="255" height="35" mode="Opaque" backcolor="#0f3d24"/>
                <graphicElement>
                    <pen lineWidth="1.0" lineColor="#b8860b"/>
                </graphicElement>
            </rectangle>

            <textField>
                <reportElement x="280" y="53" width="255" height="35" forecolor="#ffffff"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Segoe UI" size="15" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["TOTAL: RD$ " + new java.text.DecimalFormat("#,##0.00").format($P{total})]]></textFieldExpression>
            </textField>

            <rectangle>
                <reportElement x="20" y="95" width="230" height="22" mode="Opaque" backcolor="#faf8f5"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#d4c5a9"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement x="25" y="97" width="70" height="18" forecolor="#b8860b"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Segoe UI" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[PAGO CON:]]></text>
            </staticText>

            <textField>
                <reportElement x="95" y="97" width="150" height="18" forecolor="#1e293b"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Segoe UI" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{metodoPago}]]></textFieldExpression>
            </textField>

            <rectangle>
                <reportElement x="20" y="120" width="230" height="22" mode="Opaque" backcolor="#faf8f5"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#d4c5a9"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement x="25" y="122" width="90" height="18" forecolor="#b8860b"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Segoe UI" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[TIPO ENTREGA:]]></text>
            </staticText>

            <textField>
                <reportElement x="115" y="122" width="130" height="18" forecolor="#1e293b"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Segoe UI" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{tipoEntrega}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="20" y="155" width="515" height="18" forecolor="#b8860b"/>
                <textElement textAlignment="Center">
                    <font fontName="Segoe UI" size="9" isItalic="true"/>
                </textElement>
                <text><![CDATA[Gracias por su preferencia!]]></text>
            </staticText>

            <staticText>
                <reportElement x="20" y="175" width="515" height="15" forecolor="#999999"/>
                <textElement textAlignment="Center">
                    <font fontName="Segoe UI" size="7"/>
                </textElement>
                <text><![CDATA[Documento electronico valido para efectos fiscales. RNC: 1-31-00000-0]]></text>
            </staticText>

            <staticText>
                <reportElement x="20" y="173" width="515" height="15" forecolor="#999999"/>
                <textElement textAlignment="Center">
                    <font fontName="Segoe UI" size="7"/>
                </textElement>
                <text><![CDATA[Documento electronico valido para efectos fiscales. RNC: 1-31-00000-0]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>

<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="Factura" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <parameter name="numeroFactura" class="java.lang.String"/>
    <parameter name="cliente" class="java.lang.String"/>
    <parameter name="fecha" class="java.util.Date"/>
    <parameter name="subtotal" class="java.lang.Double"/>
    <parameter name="itbis" class="java.lang.Double"/>
    <parameter name="total" class="java.lang.Double"/>
    <parameter name="metodoPago" class="java.lang.String"/>
    <field name="descripcion" class="java.lang.String"/>
    <field name="libras" class="java.lang.Double"/>
    <field name="precioUnitario" class="java.lang.Double"/>
    <field name="subtotal" class="java.lang.Double"/>
    <title>
        <band height="155">
            <staticText>
                <reportElement x="0" y="0" width="555" height="35" mode="Opaque" backcolor="#2c3e50" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[QUESERIA SANTIAGUERO]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="38" width="555" height="14" forecolor="#555555"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <text><![CDATA[RNC: 1-31-00000-0 | Tel: 809-000-0000 | contacto@queseriasantiaguero.com]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="52" width="555" height="14" forecolor="#555555"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <text><![CDATA[Carretera Principal Km 12, San Jose de las Matas, Santiago, Rep. Dom.]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="72" width="555" height="2" forecolor="#2c3e50"/>
            </line>
            <staticText>
                <reportElement x="0" y="80" width="555" height="28" forecolor="#2c3e50"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="15" isBold="true"/>
                </textElement>
                <text><![CDATA[FACTURA DE VENTA]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="108" width="555" height="1" forecolor="#cccccc"/>
            </line>
            <textField>
                <reportElement x="0" y="115" width="277" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Factura No: " + $P{numeroFactura}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="278" y="115" width="277" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Fecha: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{fecha})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="135" width="555" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Cliente: " + $P{cliente}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    <columnHeader>
        <band height="28">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="28" backcolor="#34495e"/>
            </rectangle>
            <staticText>
                <reportElement x="8" y="0" width="260" height="28" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font isBold="true" size="10"/>
                </textElement>
                <text><![CDATA[PRODUCTO]]></text>
            </staticText>
            <staticText>
                <reportElement x="275" y="0" width="80" height="28" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="10"/>
                </textElement>
                <text><![CDATA[CANTIDAD]]></text>
            </staticText>
            <staticText>
                <reportElement x="360" y="0" width="95" height="28" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" size="10"/>
                </textElement>
                <text><![CDATA[PRECIO UNIT.]]></text>
            </staticText>
            <staticText>
                <reportElement x="460" y="0" width="90" height="28" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font isBold="true" size="10"/>
                </textElement>
                <text><![CDATA[SUBTOTAL]]></text>
            </staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="24">
            <line>
                <reportElement x="0" y="23" width="555" height="1" forecolor="#e0e0e0"/>
            </line>
            <textField>
                <reportElement x="8" y="0" width="260" height="23"/>
                <textElement verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="275" y="0" width="80" height="23"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[String.format("%.2f", $F{libras})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="360" y="0" width="95" height="23"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[String.format("%.2f", $F{precioUnitario})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="460" y="0" width="90" height="23"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[String.format("%.2f", $F{subtotal})]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    <summary>
        <band height="120">
            <rectangle>
                <reportElement x="278" y="0" width="277" height="75" backcolor="#f8f9fa"/>
            </rectangle>
            <line>
                <reportElement x="0" y="0" width="555" height="2" forecolor="#2c3e50"/>
            </line>
            <textField>
                <reportElement x="280" y="5" width="135" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["SUBTOTAL:"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="420" y="5" width="130" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["RD$ " + String.format("%.2f", $P{subtotal})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="280" y="27" width="135" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["ITBIS (18%):"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="420" y="27" width="130" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["RD$ " + String.format("%.2f", $P{itbis})]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="280" y="50" width="270" height="1" forecolor="#2c3e50"/>
            </line>
            <textField>
                <reportElement x="280" y="53" width="135" height="22"/>
                <textElement verticalAlignment="Middle">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["TOTAL:"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="420" y="53" width="130" height="22" forecolor="#2c3e50"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["RD$ " + String.format("%.2f", $P{total})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="82" width="300" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Metodo de Pago: " + $P{metodoPago}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="105" width="555" height="1" forecolor="#cccccc"/>
            </line>
            <staticText>
                <reportElement x="0" y="108" width="555" height="12" forecolor="#888888"/>
                <textElement textAlignment="Center">
                    <font size="8" isItalic="true"/>
                </textElement>
                <text><![CDATA[!Gracias por su preferencia! - Queseria Santiaguero]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>
